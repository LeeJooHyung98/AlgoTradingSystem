<UserControl x:Class="AlgoTrading.Desktop.Views.OrderEntryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d"
             d:DesignHeight="800" d:DesignWidth="1400">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <materialDesign:Card Grid.Row="0" Margin="16,16,16,8" Padding="24">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Order Entry"
                              Style="{StaticResource MaterialDesignHeadline4TextBlock}"
                              FontWeight="Bold"/>
                    <TextBlock Text="Create and manage your trading orders"
                              Style="{StaticResource MaterialDesignBody2TextBlock}"
                              Foreground="{DynamicResource MaterialDesignBodyLight}"
                              Margin="0,4,0,0"/>
                </StackPanel>

                <Button Grid.Column="1"
                       Content="REFRESH"
                       Style="{StaticResource MaterialDesignOutlinedButton}"
                       Command="{Binding RefreshCommand}"
                       VerticalAlignment="Center"/>
            </Grid>
        </materialDesign:Card>

        <!-- Main Content -->
        <Grid Grid.Row="1" Margin="16,8,16,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="400"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Order Entry Form -->
            <materialDesign:Card Grid.Column="0" Margin="0,0,8,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="{DynamicResource MaterialDesignToolBarBackground}">
                        <Border Padding="20,16">
                            <TextBlock Text="New Order"
                                      Style="{StaticResource MaterialDesignHeadline6TextBlock}"
                                      FontWeight="SemiBold"/>
                        </Border>
                    </Border>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="24">
                            <!-- Order Type Selection -->
                            <TextBlock Text="Order Type"
                                      Style="{StaticResource MaterialDesignBody2TextBlock}"
                                      Foreground="{DynamicResource MaterialDesignBodyLight}"
                                      Margin="0,0,0,8"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,24">
                                <RadioButton Content="Market"
                                           IsChecked="{Binding IsMarketOrder}"
                                           Style="{StaticResource MaterialDesignChoiceChipRadioButton}"
                                           Margin="0,0,8,0"/>
                                <RadioButton Content="Limit"
                                           IsChecked="{Binding IsLimitOrder}"
                                           Style="{StaticResource MaterialDesignChoiceChipRadioButton}"/>
                            </StackPanel>

                            <!-- Side Selection -->
                            <TextBlock Text="Side"
                                      Style="{StaticResource MaterialDesignBody2TextBlock}"
                                      Foreground="{DynamicResource MaterialDesignBodyLight}"
                                      Margin="0,0,0,8"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,24">
                                <RadioButton Content="Buy"
                                           IsChecked="{Binding IsBuy}"
                                           Margin="0,0,8,0">
                                    <RadioButton.Style>
                                        <Style TargetType="RadioButton" BasedOn="{StaticResource MaterialDesignChoiceChipRadioButton}">
                                            <Style.Triggers>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter Property="Background" Value="Green"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </RadioButton.Style>
                                </RadioButton>
                                <RadioButton Content="Sell"
                                           IsChecked="{Binding IsSell}">
                                    <RadioButton.Style>
                                        <Style TargetType="RadioButton" BasedOn="{StaticResource MaterialDesignChoiceChipRadioButton}">
                                            <Style.Triggers>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter Property="Background" Value="Red"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </RadioButton.Style>
                                </RadioButton>
                            </StackPanel>

                            <!-- Account Selection -->
                            <ComboBox materialDesign:HintAssist.Hint="Account Number"
                                     ItemsSource="{Binding AvailableAccounts}"
                                     SelectedItem="{Binding SelectedAccount}"
                                     Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                     Margin="0,0,0,16"/>

                            <!-- Stock Code -->
                            <TextBox materialDesign:HintAssist.Hint="Stock Code (e.g., 005930)"
                                    Text="{Binding StockCode, UpdateSourceTrigger=PropertyChanged}"
                                    Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                    Margin="0,0,0,16"/>

                            <!-- Quantity -->
                            <TextBox materialDesign:HintAssist.Hint="Quantity"
                                    Text="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}"
                                    Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                    Margin="0,0,0,16"/>

                            <!-- Limit Price (only for limit orders) -->
                            <TextBox materialDesign:HintAssist.Hint="Limit Price"
                                    Text="{Binding LimitPrice, UpdateSourceTrigger=PropertyChanged, StringFormat=N0}"
                                    IsEnabled="{Binding IsLimitPriceEnabled}"
                                    Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                    Margin="0,0,0,24"/>

                            <!-- Action Buttons -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Button Grid.Column="0"
                                       Content="SUBMIT ORDER"
                                       Command="{Binding SubmitOrderCommand}"
                                       Height="48">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignRaisedButton}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsBuy}" Value="True">
                                                    <Setter Property="Background" Value="Green"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsSell}" Value="True">
                                                    <Setter Property="Background" Value="Red"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>

                                <Button Grid.Column="2"
                                       Content="CLEAR"
                                       Command="{Binding ResetFormCommand}"
                                       Style="{StaticResource MaterialDesignOutlinedButton}"
                                       Height="48"/>
                            </Grid>

                            <!-- Order Summary -->
                            <Border Background="{DynamicResource MaterialDesignToolBarBackground}"
                                   CornerRadius="4"
                                   Padding="16"
                                   Margin="0,24,0,0">
                                <StackPanel>
                                    <TextBlock Text="Order Summary"
                                              Style="{StaticResource MaterialDesignBody2TextBlock}"
                                              FontWeight="SemiBold"
                                              Margin="0,0,0,12"/>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Type:" Margin="0,0,12,8"/>
                                        <TextBlock Grid.Row="0" Grid.Column="1" Margin="0,0,0,8">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="Limit"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsMarketOrder}" Value="True">
                                                            <Setter Property="Text" Value="Market"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>

                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Side:" Margin="0,0,12,8"/>
                                        <TextBlock Grid.Row="1" Grid.Column="1" Margin="0,0,0,8">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="Sell"/>
                                                    <Setter Property="Foreground" Value="Red"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsBuy}" Value="True">
                                                            <Setter Property="Text" Value="Buy"/>
                                                            <Setter Property="Foreground" Value="Green"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>

                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Stock:" Margin="0,0,12,8"/>
                                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding StockCode}" Margin="0,0,0,8"/>

                                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Quantity:" Margin="0,0,12,0"/>
                                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Quantity, StringFormat=N0}"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </materialDesign:Card>

            <!-- Recent Orders List -->
            <materialDesign:Card Grid.Column="1" Margin="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="{DynamicResource MaterialDesignToolBarBackground}">
                        <Border Padding="20,16">
                            <TextBlock Text="Recent Orders"
                                      Style="{StaticResource MaterialDesignHeadline6TextBlock}"
                                      FontWeight="SemiBold"/>
                        </Border>
                    </Border>

                    <DataGrid Grid.Row="1"
                             ItemsSource="{Binding RecentOrders}"
                             AutoGenerateColumns="False"
                             CanUserAddRows="False"
                             CanUserDeleteRows="False"
                             IsReadOnly="True"
                             SelectionMode="Single"
                             materialDesign:DataGridAssist.CellPadding="12"
                             materialDesign:DataGridAssist.ColumnHeaderPadding="12">

                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Stock"
                                               Binding="{Binding StockCode, Mode=OneWay}"
                                               Width="100"/>

                            <DataGridTextColumn Header="Side"
                                               Binding="{Binding Side, Mode=OneWay}"
                                               Width="80">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontWeight" Value="Bold"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsBuy}" Value="True">
                                                <Setter Property="Foreground" Value="Green"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsSell}" Value="True">
                                                <Setter Property="Foreground" Value="Red"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn Header="Type"
                                               Binding="{Binding OrderType, Mode=OneWay}"
                                               Width="80"/>

                            <DataGridTextColumn Header="Quantity"
                                               Binding="{Binding Quantity, StringFormat=N0, Mode=OneWay}"
                                               Width="100"/>

                            <DataGridTextColumn Header="Price"
                                               Binding="{Binding Price, StringFormat=N0, Mode=OneWay}"
                                               Width="110"/>

                            <DataGridTextColumn Header="Status"
                                               Binding="{Binding Status, Mode=OneWay}"
                                               Width="120">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Status}" Value="Filled">
                                                <Setter Property="Foreground" Value="Green"/>
                                                <Setter Property="FontWeight" Value="Bold"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Status}" Value="Cancelled">
                                                <Setter Property="Foreground" Value="Red"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Status}" Value="Rejected">
                                                <Setter Property="Foreground" Value="Red"/>
                                                <Setter Property="FontWeight" Value="Bold"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn Header="Time"
                                               Binding="{Binding CreatedAt, StringFormat=HH:mm:ss, Mode=OneWay}"
                                               Width="100"/>

                            <DataGridTemplateColumn Header="Actions" Width="100">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="CANCEL"
                                               Command="{Binding DataContext.CancelOrderCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                               CommandParameter="{Binding}"
                                               Foreground="Red"
                                               Height="32">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignFlatButton}">
                                                    <Setter Property="IsEnabled" Value="True"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Status}" Value="Filled">
                                                            <Setter Property="IsEnabled" Value="False"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="Cancelled">
                                                            <Setter Property="IsEnabled" Value="False"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="Rejected">
                                                            <Setter Property="IsEnabled" Value="False"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </materialDesign:Card>
        </Grid>

        <!-- Busy Indicator -->
        <Grid Grid.Row="0" Grid.RowSpan="2"
              Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}"
              Background="#80000000">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <ProgressBar Style="{StaticResource MaterialDesignCircularProgressBar}"
                           IsIndeterminate="True"
                           Width="60" Height="60"/>
                <TextBlock Text="{Binding BusyMessage}"
                          Foreground="White"
                          FontSize="16"
                          Margin="0,16,0,0"
                          HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
