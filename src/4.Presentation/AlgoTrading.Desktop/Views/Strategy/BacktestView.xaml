<UserControl x:Class="AlgoTrading.Desktop.Views.Strategy.BacktestView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="1200">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="350"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Left Panel - Settings -->
        <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="8">
                <!-- Header -->
                <materialDesign:Card Margin="0,0,0,8" Padding="16">
                    <TextBlock Text="Backtest &amp; Optimization"
                              Style="{StaticResource MaterialDesignHeadline6TextBlock}"/>
                </materialDesign:Card>

                <!-- Strategy Selection -->
                <materialDesign:Card Margin="0,0,0,8" Padding="16">
                    <StackPanel>
                        <TextBlock Text="Strategy"
                                  Style="{StaticResource MaterialDesignSubtitle1TextBlock}"
                                  Margin="0,0,0,8"/>

                        <ComboBox materialDesign:HintAssist.Hint="Select Strategy"
                                 Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                 ItemsSource="{Binding Strategies}"
                                 SelectedValue="{Binding SelectedStrategyId}"
                                 DisplayMemberPath="Name"
                                 SelectedValuePath="Id"/>

                        <Button Content="LOAD STRATEGIES"
                               Style="{StaticResource MaterialDesignOutlinedButton}"
                               Command="{Binding LoadStrategiesCommand}"
                               Margin="0,8,0,0"/>
                    </StackPanel>
                </materialDesign:Card>

                <!-- Date Range -->
                <materialDesign:Card Margin="0,0,0,8" Padding="16">
                    <StackPanel>
                        <TextBlock Text="Date Range"
                                  Style="{StaticResource MaterialDesignSubtitle1TextBlock}"
                                  Margin="0,0,0,8"/>

                        <DatePicker materialDesign:HintAssist.Hint="Start Date"
                                   Style="{StaticResource MaterialDesignOutlinedDatePicker}"
                                   SelectedDate="{Binding StartDate}"
                                   Margin="0,0,0,8"/>

                        <DatePicker materialDesign:HintAssist.Hint="End Date"
                                   Style="{StaticResource MaterialDesignOutlinedDatePicker}"
                                   SelectedDate="{Binding EndDate}"
                                   Margin="0,0,0,8"/>

                        <TextBox materialDesign:HintAssist.Hint="Initial Capital (KRW)"
                                Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                Text="{Binding InitialCapital, UpdateSourceTrigger=PropertyChanged, StringFormat=N0}"/>
                    </StackPanel>
                </materialDesign:Card>

                <!-- Backtest -->
                <materialDesign:Card Margin="0,0,0,8" Padding="16">
                    <StackPanel>
                        <TextBlock Text="Backtest"
                                  Style="{StaticResource MaterialDesignSubtitle1TextBlock}"
                                  Margin="0,0,0,8"/>

                        <Button Content="RUN BACKTEST"
                               Style="{StaticResource MaterialDesignRaisedButton}"
                               Command="{Binding RunBacktestCommand}"
                               IsEnabled="{Binding IsStrategySelected}"
                               HorizontalAlignment="Stretch"/>
                    </StackPanel>
                </materialDesign:Card>

                <!-- Optimization -->
                <materialDesign:Card Margin="0,0,0,8" Padding="16">
                    <StackPanel>
                        <TextBlock Text="Optimization"
                                  Style="{StaticResource MaterialDesignSubtitle1TextBlock}"
                                  Margin="0,0,0,8"/>

                        <ComboBox materialDesign:HintAssist.Hint="Optimization Type"
                                 Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                 ItemsSource="{Binding OptimizationTypes}"
                                 SelectedItem="{Binding OptimizationType}"
                                 Margin="0,0,0,8"/>

                        <ComboBox materialDesign:HintAssist.Hint="Objective"
                                 Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                 ItemsSource="{Binding OptimizationObjectives}"
                                 SelectedItem="{Binding OptimizationObjective}"
                                 Margin="0,0,0,8"/>

                        <Button Content="RUN OPTIMIZATION"
                               Style="{StaticResource MaterialDesignRaisedButton}"
                               Command="{Binding RunOptimizationCommand}"
                               IsEnabled="{Binding IsStrategySelected}"
                               HorizontalAlignment="Stretch"/>
                    </StackPanel>
                </materialDesign:Card>
            </StackPanel>
        </ScrollViewer>

        <!-- Right Panel - Results -->
        <Grid Grid.Column="1" Margin="8">
            <TextBlock Text="Run a backtest to see results"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      FontSize="18"
                      Foreground="{DynamicResource MaterialDesignBodyLight}"
                      Visibility="{Binding HasResult, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>

            <ScrollViewer VerticalScrollBarVisibility="Auto"
                         Visibility="{Binding HasResult, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel>
                    <!-- Header -->
                    <materialDesign:Card Margin="0,0,0,8" Padding="16">
                        <Grid>
                            <TextBlock Text="Backtest Results"
                                      Style="{StaticResource MaterialDesignHeadline6TextBlock}"
                                      VerticalAlignment="Center"/>

                            <Button Content="EXPORT"
                                   Style="{StaticResource MaterialDesignOutlinedButton}"
                                   Command="{Binding ExportResultsCommand}"
                                   HorizontalAlignment="Right"/>
                        </Grid>
                    </materialDesign:Card>

                    <!-- Summary Metrics -->
                    <materialDesign:Card Margin="0,0,0,8" Padding="16">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Period -->
                            <StackPanel Grid.Row="0" Grid.Column="0" Margin="8">
                                <TextBlock Text="Period" Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                                <TextBlock Text="{Binding Result.StartDate, StringFormat=yyyy-MM-dd}" FontWeight="Bold" FontSize="14"/>
                                <TextBlock Text="to" Foreground="{DynamicResource MaterialDesignBodyLight}" FontSize="11"/>
                                <TextBlock Text="{Binding Result.EndDate, StringFormat=yyyy-MM-dd}" FontWeight="Bold" FontSize="14"/>
                            </StackPanel>

                            <!-- Initial Capital -->
                            <StackPanel Grid.Row="0" Grid.Column="1" Margin="8">
                                <TextBlock Text="Initial Capital" Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                                <TextBlock Text="{Binding Result.InitialCapital, StringFormat=N0}" FontWeight="Bold" FontSize="16"/>
                            </StackPanel>

                            <!-- Final Capital -->
                            <StackPanel Grid.Row="0" Grid.Column="2" Margin="8">
                                <TextBlock Text="Final Capital" Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                                <TextBlock Text="{Binding Result.FinalCapital, StringFormat=N0}" FontWeight="Bold" FontSize="16">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Result.TotalReturn, Converter={StaticResource IsPositiveConverter}}" Value="True">
                                                    <Setter Property="Foreground" Value="Green"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Result.TotalReturn, Converter={StaticResource IsNegativeConverter}}" Value="True">
                                                    <Setter Property="Foreground" Value="Red"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>

                            <!-- Total Return -->
                            <StackPanel Grid.Row="0" Grid.Column="3" Margin="8">
                                <TextBlock Text="Total Return %" Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                                <TextBlock Text="{Binding Result.TotalReturn, StringFormat=N2}" FontWeight="Bold" FontSize="16">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Result.TotalReturn, Converter={StaticResource IsPositiveConverter}}" Value="True">
                                                    <Setter Property="Foreground" Value="Green"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Result.TotalReturn, Converter={StaticResource IsNegativeConverter}}" Value="True">
                                                    <Setter Property="Foreground" Value="Red"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>

                            <!-- Annualized Return -->
                            <StackPanel Grid.Row="1" Grid.Column="0" Margin="8">
                                <TextBlock Text="Annualized Return %" Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                                <TextBlock Text="{Binding Result.AnnualizedReturn, StringFormat=N2}" FontWeight="Bold" FontSize="16"/>
                            </StackPanel>

                            <!-- Sharpe Ratio -->
                            <StackPanel Grid.Row="1" Grid.Column="1" Margin="8">
                                <TextBlock Text="Sharpe Ratio" Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                                <TextBlock Text="{Binding Result.SharpeRatio, StringFormat=N3}" FontWeight="Bold" FontSize="16"/>
                            </StackPanel>

                            <!-- Max Drawdown -->
                            <StackPanel Grid.Row="1" Grid.Column="2" Margin="8">
                                <TextBlock Text="Max Drawdown" Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                                <TextBlock Text="{Binding Result.MaxDrawdown, StringFormat=N0}" FontWeight="Bold" FontSize="16" Foreground="Red"/>
                            </StackPanel>

                            <!-- Max Drawdown % -->
                            <StackPanel Grid.Row="1" Grid.Column="3" Margin="8">
                                <TextBlock Text="Max Drawdown %" Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                                <TextBlock Text="{Binding Result.MaxDrawdownPercent, StringFormat=N2}" FontWeight="Bold" FontSize="16" Foreground="Red"/>
                            </StackPanel>

                            <!-- Total Trades -->
                            <StackPanel Grid.Row="2" Grid.Column="0" Margin="8">
                                <TextBlock Text="Total Trades" Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                                <TextBlock Text="{Binding Result.TotalTrades}" FontWeight="Bold" FontSize="16"/>
                            </StackPanel>

                            <!-- Winning Trades -->
                            <StackPanel Grid.Row="2" Grid.Column="1" Margin="8">
                                <TextBlock Text="Winning Trades" Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                                <TextBlock Text="{Binding Result.WinningTrades}" FontWeight="Bold" FontSize="16" Foreground="Green"/>
                            </StackPanel>

                            <!-- Losing Trades -->
                            <StackPanel Grid.Row="2" Grid.Column="2" Margin="8">
                                <TextBlock Text="Losing Trades" Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                                <TextBlock Text="{Binding Result.LosingTrades}" FontWeight="Bold" FontSize="16" Foreground="Red"/>
                            </StackPanel>

                            <!-- Win Rate -->
                            <StackPanel Grid.Row="2" Grid.Column="3" Margin="8">
                                <TextBlock Text="Win Rate %" Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                                <TextBlock Text="{Binding Result.WinRate, StringFormat=N2}" FontWeight="Bold" FontSize="16"/>
                            </StackPanel>

                            <!-- Profit Factor -->
                            <StackPanel Grid.Row="3" Grid.Column="0" Margin="8">
                                <TextBlock Text="Profit Factor" Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                                <TextBlock Text="{Binding Result.ProfitFactor, StringFormat=N2}" FontWeight="Bold" FontSize="16"/>
                            </StackPanel>

                            <!-- Average Win -->
                            <StackPanel Grid.Row="3" Grid.Column="1" Margin="8">
                                <TextBlock Text="Average Win" Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                                <TextBlock Text="{Binding Result.AverageWin, StringFormat=N0}" FontWeight="Bold" FontSize="16" Foreground="Green"/>
                            </StackPanel>

                            <!-- Average Loss -->
                            <StackPanel Grid.Row="3" Grid.Column="2" Margin="8">
                                <TextBlock Text="Average Loss" Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                                <TextBlock Text="{Binding Result.AverageLoss, StringFormat=N0}" FontWeight="Bold" FontSize="16" Foreground="Red"/>
                            </StackPanel>

                            <!-- Profit Factor Label -->
                            <StackPanel Grid.Row="3" Grid.Column="3" Margin="8">
                                <TextBlock Text="Largest Win / Loss" Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                                <TextBlock FontWeight="Bold" FontSize="14">
                                    <Run Text="{Binding Result.LargestWin, StringFormat=N0}" Foreground="Green"/>
                                    <Run Text=" / " Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                                    <Run Text="{Binding Result.LargestLoss, StringFormat=N0}" Foreground="Red"/>
                                </TextBlock>
                            </StackPanel>
                        </Grid>
                    </materialDesign:Card>

                    <!-- Placeholder for Charts -->
                    <materialDesign:Card Margin="0,0,0,8" Padding="16">
                        <StackPanel>
                            <TextBlock Text="Equity Curve"
                                      Style="{StaticResource MaterialDesignSubtitle1TextBlock}"
                                      Margin="0,0,0,8"/>

                            <Border Height="300" Background="{DynamicResource MaterialDesignCardBackground}">
                                <TextBlock Text="Equity curve chart (requires ScottPlot implementation)"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                            </Border>
                        </StackPanel>
                    </materialDesign:Card>

                    <!-- Placeholder for Drawdown Chart -->
                    <materialDesign:Card Margin="0,0,0,8" Padding="16">
                        <StackPanel>
                            <TextBlock Text="Drawdown"
                                      Style="{StaticResource MaterialDesignSubtitle1TextBlock}"
                                      Margin="0,0,0,8"/>

                            <Border Height="200" Background="{DynamicResource MaterialDesignCardBackground}">
                                <TextBlock Text="Drawdown chart (requires ScottPlot implementation)"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                            </Border>
                        </StackPanel>
                    </materialDesign:Card>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- Busy Indicator -->
        <Grid Grid.Column="0" Grid.ColumnSpan="2"
              Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}"
              Background="#80000000">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <ProgressBar Style="{StaticResource MaterialDesignCircularProgressBar}"
                           IsIndeterminate="True"
                           Width="60" Height="60"/>
                <TextBlock Text="{Binding BusyMessage}"
                          Foreground="White"
                          FontSize="16"
                          Margin="0,16,0,0"
                          HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
