<UserControl x:Class="AlgoTrading.Desktop.Views.Strategy.StrategyMonitorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="1200">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header & Controls -->
        <materialDesign:Card Grid.Row="0" Margin="8" Padding="16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="Strategy Monitor"
                              Style="{StaticResource MaterialDesignHeadline5TextBlock}"/>
                    <TextBlock Text="{Binding LastRefresh, StringFormat='Last Refresh: {0:HH:mm:ss}'}"
                              Foreground="{DynamicResource MaterialDesignBodyLight}"
                              Margin="0,4,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <CheckBox Content="Auto Refresh"
                             IsChecked="{Binding AutoRefresh}"
                             Margin="0,0,16,0"
                             VerticalAlignment="Center"/>

                    <TextBox materialDesign:HintAssist.Hint="Interval (sec)"
                            Style="{StaticResource MaterialDesignOutlinedTextBox}"
                            Text="{Binding RefreshInterval, UpdateSourceTrigger=PropertyChanged}"
                            Width="100"
                            Margin="0,0,8,0"/>

                    <Button Content="REFRESH"
                           Style="{StaticResource MaterialDesignRaisedButton}"
                           Command="{Binding RefreshCommand}"
                           Margin="0,0,4,0"/>

                    <Button Content="START"
                           Style="{StaticResource MaterialDesignOutlinedButton}"
                           Command="{Binding StartMonitoringCommand}"
                           Margin="0,0,4,0"/>

                    <Button Content="STOP"
                           Style="{StaticResource MaterialDesignOutlinedButton}"
                           Command="{Binding StopMonitoringCommand}"/>
                </StackPanel>
            </Grid>
        </materialDesign:Card>

        <!-- Active Strategies Grid -->
        <materialDesign:Card Grid.Row="1" Margin="8">
            <DataGrid ItemsSource="{Binding ActiveStrategies}"
                     AutoGenerateColumns="False"
                     CanUserAddRows="False"
                     CanUserDeleteRows="False"
                     IsReadOnly="True"
                     SelectionMode="Single"
                     materialDesign:DataGridAssist.CellPadding="8"
                     materialDesign:DataGridAssist.ColumnHeaderPadding="8">

                <DataGrid.Columns>
                    <DataGridTextColumn Header="Name"
                                       Binding="{Binding Name}"
                                       Width="200"/>

                    <DataGridTextColumn Header="Type"
                                       Binding="{Binding Type}"
                                       Width="120"/>

                    <DataGridTextColumn Header="Status"
                                       Binding="{Binding Status}"
                                       Width="100">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="Foreground" Value="Green"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <DataGridTextColumn Header="Running Time"
                                       Binding="{Binding RunningTime}"
                                       Width="100"/>

                    <DataGridTextColumn Header="Total Trades"
                                       Binding="{Binding TotalTrades}"
                                       Width="100"/>

                    <DataGridTextColumn Header="Win"
                                       Binding="{Binding WinningTrades}"
                                       Width="80">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="Green"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <DataGridTextColumn Header="Loss"
                                       Binding="{Binding LosingTrades}"
                                       Width="80">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="Red"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <DataGridTextColumn Header="Win Rate %"
                                       Binding="{Binding WinRate, StringFormat=N2}"
                                       Width="100">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding WinRate, Converter={StaticResource GreaterThanConverter}, ConverterParameter=50}" Value="True">
                                        <Setter Property="Foreground" Value="Green"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding WinRate, Converter={StaticResource LessThanConverter}, ConverterParameter=50}" Value="True">
                                        <Setter Property="Foreground" Value="Red"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <DataGridTextColumn Header="Total P&amp;L"
                                       Binding="{Binding TotalPnL, StringFormat=N0}"
                                       Width="120">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding TotalPnL, Converter={StaticResource IsPositiveConverter}}" Value="True">
                                        <Setter Property="Foreground" Value="Green"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding TotalPnL, Converter={StaticResource IsNegativeConverter}}" Value="True">
                                        <Setter Property="Foreground" Value="Red"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <DataGridTextColumn Header="Last Signal"
                                       Binding="{Binding LastSignalDisplay}"
                                       Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </materialDesign:Card>

        <!-- Summary Statistics -->
        <materialDesign:Card Grid.Row="2" Margin="8" Padding="16">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <StackPanel Margin="0,0,32,0">
                    <TextBlock Text="Active Strategies" Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                    <TextBlock Text="{Binding ActiveStrategies.Count}" FontWeight="Bold" FontSize="24" HorizontalAlignment="Center"/>
                </StackPanel>

                <StackPanel Margin="0,0,32,0">
                    <TextBlock Text="Total Trades" Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                    <TextBlock FontWeight="Bold" FontSize="24" HorizontalAlignment="Center">
                        <Run Text="{Binding ActiveStrategies, Converter={StaticResource SumConverter}, ConverterParameter='TotalTrades', Mode=OneWay}"/>
                    </TextBlock>
                </StackPanel>

                <StackPanel Margin="0,0,32,0">
                    <TextBlock Text="Total Wins" Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                    <TextBlock FontWeight="Bold" FontSize="24" HorizontalAlignment="Center" Foreground="Green">
                        <Run Text="{Binding ActiveStrategies, Converter={StaticResource SumConverter}, ConverterParameter='WinningTrades', Mode=OneWay}"/>
                    </TextBlock>
                </StackPanel>

                <StackPanel Margin="0,0,32,0">
                    <TextBlock Text="Total Losses" Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                    <TextBlock FontWeight="Bold" FontSize="24" HorizontalAlignment="Center" Foreground="Red">
                        <Run Text="{Binding ActiveStrategies, Converter={StaticResource SumConverter}, ConverterParameter='LosingTrades', Mode=OneWay}"/>
                    </TextBlock>
                </StackPanel>

                <StackPanel>
                    <TextBlock Text="Combined P&amp;L" Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                    <TextBlock FontWeight="Bold" FontSize="24" HorizontalAlignment="Center">
                        <Run Text="{Binding ActiveStrategies, Converter={StaticResource SumConverter}, ConverterParameter='TotalPnL', StringFormat=N0, Mode=OneWay}"/>
                    </TextBlock>
                </StackPanel>
            </StackPanel>
        </materialDesign:Card>

        <!-- Busy Indicator -->
        <Grid Grid.Row="0" Grid.RowSpan="3"
              Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}"
              Background="#80000000">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <ProgressBar Style="{StaticResource MaterialDesignCircularProgressBar}"
                           IsIndeterminate="True"
                           Width="60" Height="60"/>
                <TextBlock Text="{Binding BusyMessage}"
                          Foreground="White"
                          FontSize="16"
                          Margin="0,16,0,0"
                          HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
