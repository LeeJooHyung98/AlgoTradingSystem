using AlgoTrading.Application.Services.Strategy;
using AlgoTrading.Core.Entities.Strategy;
using AlgoTrading.Core.Enums;
using AlgoTrading.Core.Interfaces.Repositories;
using AlgoTrading.Infrastructure.Persistence;
using AlgoTrading.Infrastructure.Persistence.Repositories;
using FluentAssertions;
using Microsoft.EntityFrameworkCore;
using Microsoft.Extensions.Logging;
using NSubstitute;
using Xunit;

namespace AlgoTrading.IntegrationTests.Services.Strategy;

/// <summary>
/// Integration tests for Strategy Optimization
/// Tests the complete optimization flow with backtest service
/// </summary>
public class OptimizationIntegrationTests : IDisposable
{
    private readonly AlgoTradingDbContext _dbContext;
    private readonly IStrategyRepository _strategyRepository;
    private readonly IBacktestService _backtestService;
    private readonly IStrategyService _strategyService;
    private readonly IUnitOfWork _unitOfWork;
    private readonly StrategyOptimizationService _sut;

    public OptimizationIntegrationTests()
    {
        // Setup InMemory database
        var options = new DbContextOptionsBuilder<AlgoTradingDbContext>()
            .UseInMemoryDatabase(databaseName: Guid.NewGuid().ToString())
            .Options;

        _dbContext = new AlgoTradingDbContext(options);
        _strategyRepository = new StrategyRepository(_dbContext);
        _unitOfWork = _dbContext; // DbContext implements IUnitOfWork

        // Mock services
        _backtestService = Substitute.For<IBacktestService>();
        _strategyService = Substitute.For<IStrategyService>();

        var logger = Substitute.For<ILogger<StrategyOptimizationService>>();
        _sut = new StrategyOptimizationService(logger, _strategyRepository, _strategyService, _backtestService, _unitOfWork);
    }

    public void Dispose()
    {
        _dbContext.Database.EnsureDeleted();
        _dbContext.Dispose();
    }

    #region Helper Methods

    private async Task<Guid> CreateTestStrategyAsync()
    {
        var strategy = TradingStrategy.Create(
            "Test Strategy",
            "Test Description",
            Core.Entities.Strategy.StrategyType.Momentum,
            "TestUser");

        _dbContext.Strategies.Add(strategy);
        await _dbContext.SaveChangesAsync();

        return strategy.Id.Value;
    }

    private BacktestResult CreateBacktestResult(Guid strategyId, decimal returnPercent, decimal sharpeRatio)
    {
        var initialCapital = 10000000m;
        var finalCapital = initialCapital * (1 + returnPercent / 100);

        return new BacktestResult
        {
            BacktestId = Guid.NewGuid(),
            StrategyId = strategyId,
            StartDate = DateTime.UtcNow.AddDays(-30),
            EndDate = DateTime.UtcNow,
            InitialCapital = initialCapital,
            FinalCapital = finalCapital,
            Metrics = new PerformanceMetrics
            {
                TotalReturn = returnPercent,
                AnnualizedReturn = returnPercent * 12, // Assuming monthly
                SharpeRatio = sharpeRatio,
                MaxDrawdown = initialCapital * 0.05m,
                MaxDrawdownPercent = 5m,
                TotalTrades = 50,
                WinningTrades = 30,
                LosingTrades = 20,
                WinRate = 60m,
                ProfitFactor = 1.8m,
                AverageWin = 50000m,
                AverageLoss = -30000m,
                LargestWin = 150000m,
                LargestLoss = -80000m
            }
        };
    }

    #endregion

    #region GridSearch Integration Tests

    [Fact]
    public async Task GridSearchAsync_WithMockedBacktest_ShouldFindOptimalParameters()
    {
        // Arrange
        var strategyId = await CreateTestStrategyAsync();

        var parameterRanges = new Dictionary<string, ParameterRange>
        {
            { "Period", new ParameterRange(10, 30, 10, ParameterType.Integer) } // 10, 20, 30
        };

        // Mock backtest results with different performance for each parameter
        var callCount = 0;
        _backtestService.RunBacktestAsync(
            Arg.Any<Guid>(),
            Arg.Any<DateTime>(),
            Arg.Any<DateTime>(),
            Arg.Any<decimal>(),
            Arg.Any<CancellationToken>())
            .Returns(call =>
            {
                callCount++;
                var returnPercent = 5m + callCount * 2m; // 7%, 9%, 11%
                var sharpe = 1.0m + callCount * 0.3m;
                return CreateBacktestResult(strategyId, returnPercent, sharpe);
            });

        // Act
        var result = await _sut.GridSearchAsync(
            strategyId,
            parameterRanges,
            OptimizationObjective.MaxReturn,
            DateTime.UtcNow.AddDays(-30),
            DateTime.UtcNow,
            10000000m);

        // Assert
        result.IsError.Should().BeFalse();
        result.Value.Should().NotBeNull();
        result.Value.TotalCombinations.Should().Be(3);
        result.Value.OptimizationType.Should().Be(OptimizationType.GridSearch);
        result.Value.BestParameters.Should().ContainKey("Period");
        result.Value.BestScore.Should().BeGreaterThan(0);

        // Verify backtest was called for each combination
        await _backtestService.Received(3).RunBacktestAsync(
            Arg.Any<Guid>(),
            Arg.Any<DateTime>(),
            Arg.Any<DateTime>(),
            Arg.Any<decimal>(),
            Arg.Any<CancellationToken>());
    }

    [Fact]
    public async Task GridSearchAsync_WithMultipleParameters_ShouldTestAllCombinations()
    {
        // Arrange
        var strategyId = await CreateTestStrategyAsync();

        var parameterRanges = new Dictionary<string, ParameterRange>
        {
            { "FastPeriod", new ParameterRange(5, 15, 5, ParameterType.Integer) },    // 5, 10, 15 = 3 values
            { "SlowPeriod", new ParameterRange(20, 40, 10, ParameterType.Integer) }   // 20, 30, 40 = 3 values
        };
        // Total combinations: 3 * 3 = 9

        _backtestService.RunBacktestAsync(
            Arg.Any<Guid>(),
            Arg.Any<DateTime>(),
            Arg.Any<DateTime>(),
            Arg.Any<decimal>(),
            Arg.Any<CancellationToken>())
            .Returns(call => CreateBacktestResult(strategyId, 10m, 1.5m));

        // Act
        var result = await _sut.GridSearchAsync(
            strategyId,
            parameterRanges,
            OptimizationObjective.MaxReturn,
            DateTime.UtcNow.AddDays(-30),
            DateTime.UtcNow,
            10000000m);

        // Assert
        result.IsError.Should().BeFalse();
        result.Value.TotalCombinations.Should().Be(9);
        result.Value.BestParameters.Should().HaveCount(2);
        result.Value.BestParameters.Should().ContainKey("FastPeriod");
        result.Value.BestParameters.Should().ContainKey("SlowPeriod");

        await _backtestService.Received(9).RunBacktestAsync(
            Arg.Any<Guid>(),
            Arg.Any<DateTime>(),
            Arg.Any<DateTime>(),
            Arg.Any<decimal>(),
            Arg.Any<CancellationToken>());
    }

    #endregion

    #region RandomSearch Integration Tests

    [Fact]
    public async Task RandomSearchAsync_ShouldTestSpecifiedNumberOfIterations()
    {
        // Arrange
        var strategyId = await CreateTestStrategyAsync();

        var parameterRanges = new Dictionary<string, ParameterRange>
        {
            { "Period", new ParameterRange(5, 100, 1, ParameterType.Integer) }
        };

        _backtestService.RunBacktestAsync(
            Arg.Any<Guid>(),
            Arg.Any<DateTime>(),
            Arg.Any<DateTime>(),
            Arg.Any<decimal>(),
            Arg.Any<CancellationToken>())
            .Returns(call => CreateBacktestResult(strategyId, 8m, 1.3m));

        // Act
        var result = await _sut.RandomSearchAsync(
            strategyId,
            parameterRanges,
            OptimizationObjective.MaxSharpe,
            DateTime.UtcNow.AddDays(-30),
            DateTime.UtcNow,
            10000000m,
            iterations: 20);

        // Assert
        result.IsError.Should().BeFalse();
        result.Value.TotalCombinations.Should().Be(20);
        result.Value.OptimizationType.Should().Be(OptimizationType.RandomSearch);

        await _backtestService.Received(20).RunBacktestAsync(
            Arg.Any<Guid>(),
            Arg.Any<DateTime>(),
            Arg.Any<DateTime>(),
            Arg.Any<decimal>(),
            Arg.Any<CancellationToken>());
    }

    #endregion

    #region GeneticAlgorithm Integration Tests

    [Fact]
    public async Task GeneticAlgorithmAsync_ShouldEvolvePopulationOverGenerations()
    {
        // Arrange
        var strategyId = await CreateTestStrategyAsync();

        var parameterRanges = new Dictionary<string, ParameterRange>
        {
            { "FastPeriod", new ParameterRange(5, 20, 1, ParameterType.Integer) },
            { "SlowPeriod", new ParameterRange(20, 50, 1, ParameterType.Integer) }
        };

        _backtestService.RunBacktestAsync(
            Arg.Any<Guid>(),
            Arg.Any<DateTime>(),
            Arg.Any<DateTime>(),
            Arg.Any<decimal>(),
            Arg.Any<CancellationToken>())
            .Returns(call => CreateBacktestResult(strategyId, 12m, 2.0m));

        // Act
        var result = await _sut.GeneticAlgorithmAsync(
            strategyId,
            parameterRanges,
            OptimizationObjective.MaxSharpe,
            DateTime.UtcNow.AddDays(-30),
            DateTime.UtcNow,
            populationSize: 10,
            generations: 5,
            mutationRate: 0.1);

        // Assert
        result.IsError.Should().BeFalse();
        result.Value.OptimizationType.Should().Be(OptimizationType.GeneticAlgorithm);
        result.Value.BestParameters.Should().HaveCount(2);

        // GA should test: populationSize * generations = 10 * 5 = 50 combinations
        await _backtestService.Received(50).RunBacktestAsync(
            Arg.Any<Guid>(),
            Arg.Any<DateTime>(),
            Arg.Any<DateTime>(),
            Arg.Any<decimal>(),
            Arg.Any<CancellationToken>());
    }

    #endregion

    #region WalkForwardAnalysis Integration Tests

    [Fact]
    public async Task WalkForwardAnalysisAsync_ShouldUseWalkForwardBacktest()
    {
        // Arrange
        var strategyId = await CreateTestStrategyAsync();

        var parameterRanges = new Dictionary<string, ParameterRange>
        {
            { "Period", new ParameterRange(10, 30, 10, ParameterType.Integer) }
        };

        // Mock both regular backtest and walk-forward backtest
        _backtestService.RunBacktestAsync(
            Arg.Any<Guid>(),
            Arg.Any<DateTime>(),
            Arg.Any<DateTime>(),
            Arg.Any<decimal>(),
            Arg.Any<CancellationToken>())
            .Returns(call => CreateBacktestResult(strategyId, 10m, 1.5m));

        var walkForwardResult = new WalkForwardBacktestResult
        {
            BacktestId = Guid.NewGuid(),
            StrategyId = strategyId,
            StartDate = DateTime.UtcNow.AddDays(-90),
            EndDate = DateTime.UtcNow,
            InitialCapital = 10000000m,
            FinalCapital = 11000000m,
            OverallMetrics = new PerformanceMetrics
            {
                TotalReturn = 10m,
                SharpeRatio = 1.5m,
                MaxDrawdown = 500000m,
                TotalTrades = 50,
                WinRate = 60m
            }
        };

        _backtestService.RunWalkForwardBacktestAsync(
            Arg.Any<Guid>(),
            Arg.Any<DateTime>(),
            Arg.Any<DateTime>(),
            Arg.Any<decimal>(),
            Arg.Any<int>(),
            Arg.Any<int>(),
            Arg.Any<CancellationToken>())
            .Returns(walkForwardResult);

        // Act
        var result = await _sut.WalkForwardAnalysisAsync(
            strategyId,
            parameterRanges,
            OptimizationObjective.MaxReturn,
            DateTime.UtcNow.AddDays(-90),
            DateTime.UtcNow,
            10000000m,
            inSampleDays: 30,
            outOfSampleDays: 30);

        // Assert
        result.IsError.Should().BeFalse();
        result.Value.OptimizationType.Should().Be(OptimizationType.WalkForward);

        await _backtestService.Received().RunWalkForwardBacktestAsync(
            Arg.Any<Guid>(),
            Arg.Any<DateTime>(),
            Arg.Any<DateTime>(),
            Arg.Any<decimal>(),
            30, // inSampleDays
            30, // outOfSampleDays
            Arg.Any<CancellationToken>());
    }

    #endregion

    #region ParameterSensitivity Integration Tests

    [Fact]
    public async Task ParameterSensitivityAsync_ShouldTestRangeOfValues()
    {
        // Arrange
        var strategyId = await CreateTestStrategyAsync();

        var parameterRange = new ParameterRange(10, 50, 10, ParameterType.Integer); // 10, 20, 30, 40, 50 = 5 values

        var callCount = 0;
        _backtestService.RunBacktestAsync(
            Arg.Any<Guid>(),
            Arg.Any<DateTime>(),
            Arg.Any<DateTime>(),
            Arg.Any<decimal>(),
            Arg.Any<CancellationToken>())
            .Returns(call =>
            {
                callCount++;
                var returnPercent = 5m + callCount * 1.5m;
                var sharpe = 1.0m + callCount * 0.2m;
                return CreateBacktestResult(strategyId, returnPercent, sharpe);
            });

        // Act
        var result = await _sut.ParameterSensitivityAsync(
            strategyId,
            "Period",
            parameterRange,
            DateTime.UtcNow.AddDays(-30),
            DateTime.UtcNow,
            10000000m);

        // Assert
        result.IsError.Should().BeFalse();
        result.Value.ParameterName.Should().Be("Period");
        result.Value.SensitivityData.Should().HaveCount(5);

        // Verify sensitivity data is sorted by parameter value
        result.Value.SensitivityData.Should().BeInAscendingOrder(x => x.ParameterValue);

        await _backtestService.Received(5).RunBacktestAsync(
            Arg.Any<Guid>(),
            Arg.Any<DateTime>(),
            Arg.Any<DateTime>(),
            Arg.Any<decimal>(),
            Arg.Any<CancellationToken>());
    }

    #endregion

    #region MonteCarloSimulation Integration Tests

    [Fact]
    public async Task MonteCarloSimulationAsync_ShouldRunMultipleSimulations()
    {
        // Arrange
        var strategyId = await CreateTestStrategyAsync();

        var backtestResult = CreateBacktestResult(strategyId, 10m, 1.5m);
        backtestResult.Trades = new List<BacktestTrade>
        {
            new BacktestTrade
            {
                EntryTime = DateTime.UtcNow.AddDays(-20),
                ExitTime = DateTime.UtcNow.AddDays(-19),
                EntryPrice = 10000,
                ExitPrice = 10500,
                Quantity = 100,
                RealizedPL = 50000,
                RealizedPLPercent = 5m,
                StockCode = "005930"
            },
            new BacktestTrade
            {
                EntryTime = DateTime.UtcNow.AddDays(-15),
                ExitTime = DateTime.UtcNow.AddDays(-14),
                EntryPrice = 20000,
                ExitPrice = 19500,
                Quantity = 50,
                RealizedPL = -25000,
                RealizedPLPercent = -2.5m,
                StockCode = "000660"
            }
        };

        _backtestService.RunBacktestAsync(
            Arg.Any<Guid>(),
            Arg.Any<DateTime>(),
            Arg.Any<DateTime>(),
            Arg.Any<decimal>(),
            Arg.Any<CancellationToken>())
            .Returns(backtestResult);

        // Act
        var result = await _sut.MonteCarloSimulationAsync(
            strategyId,
            DateTime.UtcNow.AddDays(-30),
            DateTime.UtcNow,
            10000000m,
            simulations: 100);

        // Assert
        result.IsError.Should().BeFalse();
        result.Value.Simulations.Should().Be(100);
        result.Value.AverageReturn.Should().NotBe(0);
        result.Value.StandardDeviation.Should().BeGreaterThan(0);
        result.Value.Percentile5.Should().BeLessThan(result.Value.Percentile95);

        // Verify backtest was called once to get trade history
        await _backtestService.Received(1).RunBacktestAsync(
            Arg.Any<Guid>(),
            Arg.Any<DateTime>(),
            Arg.Any<DateTime>(),
            Arg.Any<decimal>(),
            Arg.Any<CancellationToken>());
    }

    #endregion

    #region OptimizationObjective Tests

    [Theory]
    [InlineData(OptimizationObjective.MaxReturn)]
    [InlineData(OptimizationObjective.MaxSharpe)]
    [InlineData(OptimizationObjective.MinDrawdown)]
    [InlineData(OptimizationObjective.MaxProfitFactor)]
    [InlineData(OptimizationObjective.MaxWinRate)]
    public async Task GridSearchAsync_WithDifferentObjectives_ShouldOptimizeCorrectly(
        OptimizationObjective objective)
    {
        // Arrange
        var strategyId = await CreateTestStrategyAsync();

        var parameterRanges = new Dictionary<string, ParameterRange>
        {
            { "Period", new ParameterRange(10, 20, 5, ParameterType.Integer) }
        };

        _backtestService.RunBacktestAsync(
            Arg.Any<Guid>(),
            Arg.Any<DateTime>(),
            Arg.Any<DateTime>(),
            Arg.Any<decimal>(),
            Arg.Any<CancellationToken>())
            .Returns(call => CreateBacktestResult(strategyId, 10m, 1.5m));

        // Act
        var result = await _sut.GridSearchAsync(
            strategyId,
            parameterRanges,
            objective,
            DateTime.UtcNow.AddDays(-30),
            DateTime.UtcNow,
            10000000m);

        // Assert
        result.IsError.Should().BeFalse();
        result.Value.Objective.Should().Be(objective);
        result.Value.BestScore.Should().BeGreaterThan(0);
    }

    #endregion

    #region Error Handling Integration Tests

    [Fact]
    public async Task GridSearchAsync_WhenBacktestFails_ShouldSkipCombination()
    {
        // Arrange
        var strategyId = await CreateTestStrategyAsync();

        var parameterRanges = new Dictionary<string, ParameterRange>
        {
            { "Period", new ParameterRange(10, 30, 10, ParameterType.Integer) }
        };

        var callCount = 0;
        _backtestService.RunBacktestAsync(
            Arg.Any<Guid>(),
            Arg.Any<DateTime>(),
            Arg.Any<DateTime>(),
            Arg.Any<decimal>(),
            Arg.Any<CancellationToken>())
            .Returns(call =>
            {
                callCount++;
                // First call fails, others succeed
                if (callCount == 1)
                {
                    return Error.Failure("Backtest.Failed", "Backtest failed");
                }
                return CreateBacktestResult(strategyId, 10m, 1.5m);
            });

        // Act
        var result = await _sut.GridSearchAsync(
            strategyId,
            parameterRanges,
            OptimizationObjective.MaxReturn,
            DateTime.UtcNow.AddDays(-30),
            DateTime.UtcNow,
            10000000m);

        // Assert
        result.IsError.Should().BeFalse();
        result.Value.TotalCombinations.Should().Be(3);
        // Best score should be from successful backtests
        result.Value.BestScore.Should().BeGreaterThan(0);
    }

    #endregion
}
